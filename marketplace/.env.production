# Frontend Production Environment Variables
NODE_ENV=production

# Render Node API — single backend host for HTTP + WebSocket.
# backend.ts reads NEXT_PUBLIC_BACKEND_URL; the others are legacy aliases.
NEXT_PUBLIC_BACKEND_URL=https://valueskins-web-service.onrender.com
NEXT_PUBLIC_API_URL=https://valueskins-web-service.onrender.com
NEXT_PUBLIC_WS_URL=wss://valueskins-web-service.onrender.com/ws

RAZORPAY_KEY_ID=rzp_live_[your_production_key]
PAYMENT_GATEWAY=razorpay
