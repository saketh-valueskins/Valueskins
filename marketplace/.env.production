# Database — comes from the Vercel dashboard (Production) ONLY.
# This file used to commit a live DATABASE_URL including the password
# (ui-specs/flagged.md F9). Anyone with repo access had the credential, and the
# Render host's 5432 is reachable from the public internet. Same reasoning as
# the OAuth vars below: never commit a value that can override the real one.

# Google OAuth — provided by Vercel dashboard env (Production).
# Do NOT set placeholder values here: Next.js loads .env.production at build
# and inlines NEXT_PUBLIC_* values, which OVERRODE the real Vercel values and
# broke OAuth (client_id baked as "<SET_IN_VERCEL>"). Left unset on purpose.

# hCaptcha (dev/test keys — replace with real ones for production)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000000"
HCAPTCHA_SECRET_KEY="0x0000000000000000000000000000000000000000"

# App
NODE_ENV=production
# NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_GOOGLE_REDIRECT_URI come from the Vercel
# dashboard (Production) — pointed at https://valueskins.com. Not set here so
# the committed file can't override the real values at build time.

# Backend — Render API Gateway (set after first deploy)
# Replace with your actual Render service URL after deploying the backend
NEXT_PUBLIC_BACKEND_URL="https://valueskins-api.onrender.com"
NEXT_PUBLIC_WS_URL="wss://valueskins-api.onrender.com/ws"
