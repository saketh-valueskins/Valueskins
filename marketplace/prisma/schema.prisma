generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String   @id @default(cuid())
  email           String   @unique
  display_name    String?
  avatar_url      String?
  
  onboarding_stage String @default("incomplete")
  instagram_id    String?  @unique
  instagram_bio   String?
  instagram_avatar String?
  
  account_type    String   @default("creator")
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  creator_profile CreatorProfile?
  brand_profile   BrandProfile?
  creator_payout  CreatorPayout?
  deals_as_creator Deal[] @relation("creator")
  deals_as_brand   Deal[] @relation("brand")
  transactions     Transaction[]
  deal_messages    DealMessage[]
}

model CreatorProfile {
  id              String   @id @default(cuid())
  account_id      String   @unique
  account         Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  
  bio             String?
  niche           String?
  rate            Int?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model BrandProfile {
  id              String   @id @default(cuid())
  account_id      String   @unique
  account         Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  
  company_name    String?
  industry        String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model CreatorPayout {
  id                    String   @id @default(cuid())
  creator_id            String   @unique
  creator               Account  @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  
  razorpay_contact_id   String   @unique
  fund_account_id       String   @unique
  
  upi_id_masked         String?
  bank_account_masked   String?
  
  payment_method        String   @default("upi")
  verified              Boolean  @default(false)
  
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model Deal {
  id                      String   @id @default(cuid())
  creator_id              String
  creator                 Account  @relation("creator", fields: [creator_id], references: [id], onDelete: Cascade)
  
  brand_id                String
  brand                   Account  @relation("brand", fields: [brand_id], references: [id], onDelete: Cascade)
  
  title                   String
  description             String?
  requirements            String
  script                  String?
  
  total_budget            Decimal  @db.Numeric(10, 2)
  commission_amount       Decimal  @db.Numeric(10, 2)
  creator_payout_amount   Decimal  @db.Numeric(10, 2)
  creator_advance         Decimal  @db.Numeric(10, 2)
  creator_final           Decimal  @db.Numeric(10, 2)
  
  status                  String   @default("pending_commission_payment")
  
  commission_paid_at      DateTime?
  razorpay_commission_payment_id String?
  
  advance_initiated_at    DateTime?
  advance_paid_at         DateTime?
  razorpay_advance_transfer_id String?
  
  final_initiated_at      DateTime?
  final_paid_at           DateTime?
  razorpay_final_transfer_id String?
  
  work_submitted_at       DateTime?
  work_approved_at        DateTime?
  completed_at            DateTime?
  
  adp_generated           Boolean  @default(false)
  adp_generated_at        DateTime?
  adp_number              BigInt?  @unique
  
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  
  transactions            Transaction[]
  messages                DealMessage[]
  gst_invoice             GSTInvoice?
  adp_document            ADPDocument?
}

model Transaction {
  id                      String   @id @default(cuid())
  deal_id                 String
  deal                    Deal     @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  
  account_id              String
  account                 Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  
  type                    String
  amount                  Decimal  @db.Numeric(10, 2)
  status                  String   @default("pending")
  
  razorpay_payment_id     String?
  razorpay_transfer_id    String?
  
  created_at              DateTime @default(now())
  completed_at            DateTime?
}

model GSTInvoice {
  id                      String   @id @default(cuid())
  invoice_number          String   @unique
  deal_id                 String   @unique
  deal                    Deal     @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  
  brand_id                String
  
  base_amount             Decimal  @db.Numeric(10, 2)
  gst_rate                Int      @default(18)
  gst_amount              Decimal  @db.Numeric(10, 2)
  total_amount            Decimal  @db.Numeric(10, 2)
  
  razorpay_invoice_id     String?
  razorpay_short_url      String?
  
  status                  String   @default("issued")
  
  sent_to_email           String?
  sent_at                 DateTime?
  
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model ADPDocument {
  id                      String   @id @default(cuid())
  deal_id                 String   @unique
  deal                    Deal     @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  
  adp_number              BigInt   @unique
  
  pdf_data                Bytes
  pdf_size_bytes          BigInt?
  
  hash                    String?
  
  generated_at            DateTime @default(now())
  
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model DealMessage {
  id                      String   @id @default(cuid())
  deal_id                 String
  deal                    Deal     @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  
  sender_id               String
  sender                  Account  @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  
  content                 String
  
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model ADPCounter {
  id                      String   @id @default("adp")
  current_number          BigInt   @default(0)
  updated_at              DateTime @updatedAt
}
